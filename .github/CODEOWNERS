# Everything Flux reconciles into the cluster.
#
# Delivery objects belong to @flux; component configuration belongs to the
# workstream that runs the component. The workstreams share this repository
# without merge contention because none of them touch the same directories.
#
# Restored after commit a772c0f9 deleted this file, and remapped onto the
# layout that commit introduced: component config now lives under
# /infrastructures/base/<component>/ (definitions) and
# /infrastructures/dev/<cluster>/<component>/ (per-cluster overlays).
# Ownership follows the component, not the tree.

# Fallback, FIRST on purpose. In CODEOWNERS the LAST matching pattern wins,
# so a `*` line at the bottom of the file silently overrides every specific
# rule below it - which is what this file did until #106: PRs touching only
# /infrastructures/base/cert-manager/ were routed to @flux and @cto, never
# to @utils, and every workstream had been adding its own reviewers by hand
# to compensate. Keep this line above the per-component rules.
*                                                            @Ubuntu-25c-market-prep/flux @Ubuntu-25c-market-prep/cto

# Flux delivery objects - bootstrap, sources, cluster Kustomizations.
/clusters/                                                   @Ubuntu-25c-market-prep/flux
/infrastructures/base/000-helm-repository/                   @Ubuntu-25c-market-prep/flux
/infrastructures/dev/25c-shared/flux-system/                 @Ubuntu-25c-market-prep/flux
/infrastructures/dev/25c-shared/000-cluster-wide-resources/  @Ubuntu-25c-market-prep/flux

# Utils - sealed-secrets, cert-manager, external-dns.
/infrastructures/base/sealed-secrets/                        @Ubuntu-25c-market-prep/utils
/infrastructures/dev/25c-shared/sealed-secrets/              @Ubuntu-25c-market-prep/utils
/infrastructures/base/cert-manager/                          @Ubuntu-25c-market-prep/utils
/infrastructures/dev/25c-shared/cert-manager/                @Ubuntu-25c-market-prep/utils
/infrastructures/base/external-dns/                          @Ubuntu-25c-market-prep/utils
/infrastructures/dev/25c-shared/external-dns/                @Ubuntu-25c-market-prep/utils

# Scaling - karpenter.
#
# karpenter-nodepool/ is a THIRD directory, not a typo. The NodePool and
# EC2NodeClass custom resources cannot live beside the controller's HelmRelease:
# they depend on CRDs that HelmRelease installs, so they are applied as a
# separate step once the controller is Ready. Without a rule of its own that
# directory falls through to the `*` fallback and lands on @flux and @cto -
# which is exactly what happened on #107.
/infrastructures/base/karpenter/                             @Ubuntu-25c-market-prep/scaling
/infrastructures/dev/25c-shared/karpenter/                   @Ubuntu-25c-market-prep/scaling
/infrastructures/dev/25c-shared/karpenter-nodepool/          @Ubuntu-25c-market-prep/scaling

# metrics-server serves the Metrics API that every HPA reads, so it belongs to
# the workstream that owns HPA. Listed explicitly for the same reason
# karpenter-nodepool is: without a rule of its own it falls through to the `*`
# fallback and lands on @flux and @cto instead of the team that runs it.
/infrastructures/base/metrics-server/                        @Ubuntu-25c-market-prep/scaling
/infrastructures/dev/25c-shared/metrics-server/              @Ubuntu-25c-market-prep/scaling

# Logging - EFK stack (ECK operator, Elasticsearch and Fluent Bit; Kibana follows).
#
# elasticsearch/ is overlay-only and has no base/ counterpart: node count, disk
# and version are per-cluster decisions. It still needs a rule of its own, for
# the same reason karpenter-nodepool and metrics-server do - without one the
# directory falls through to the `*` fallback and lands on @flux and @cto.
/infrastructures/base/eck-operator/                          @Ubuntu-25c-market-prep/logging
/infrastructures/dev/25c-shared/eck-operator/                @Ubuntu-25c-market-prep/logging
/infrastructures/dev/25c-shared/elasticsearch/               @Ubuntu-25c-market-prep/logging
/infrastructures/dev/25c-shared/elasticsearch-ilm/           @Ubuntu-25c-market-prep/logging
/infrastructures/base/fluent-bit/                            @Ubuntu-25c-market-prep/logging
/infrastructures/dev/25c-shared/fluent-bit/                  @Ubuntu-25c-market-prep/logging
/infrastructures/dev/25c-shared/kibana/                      @Ubuntu-25c-market-prep/logging

# Mesh - istio.
/infrastructures/base/istio-base/                            @Ubuntu-25c-market-prep/istio
/infrastructures/base/istiod/                                @Ubuntu-25c-market-prep/istio
/infrastructures/base/istio-gateway/                         @Ubuntu-25c-market-prep/istio
/infrastructures/dev/25c-shared/istio-base/                  @Ubuntu-25c-market-prep/istio
/infrastructures/dev/25c-shared/istiod/                      @Ubuntu-25c-market-prep/istio
/infrastructures/dev/25c-shared/istio-gateway/               @Ubuntu-25c-market-prep/istio

# Security - kyverno, policy-reporter.
/infrastructures/base/kyverno/                               @Ubuntu-25c-market-prep/security
/infrastructures/dev/25c-shared/kyverno/                     @Ubuntu-25c-market-prep/security

# Delivery - argo-cd. Added in #140; without these two rules the component
# falls through to the `*` fallback and the argocd workstream cannot review its
# own HelmRelease.
/infrastructures/base/argo-cd/                               @Ubuntu-25c-market-prep/argocd
/infrastructures/dev/25c-shared/argo-cd/                     @Ubuntu-25c-market-prep/argocd

# The four namespaces that carry `u25c.io/owner: argocd`. File-level rules on
# purpose: 000-cluster-wide-resources/ stays @flux above, so every OTHER
# namespace in that directory is unaffected and only these four move.
#
# Not listed here, deliberately: clusters/dev/25c-shared/argo-bootstrap.yaml.
# That is a Flux Kustomization - Flux's own object, on Flux's side of the
# boundary contract (ADR 0015) - and stays @flux.
/infrastructures/dev/25c-shared/000-cluster-wide-resources/namespace/app-dev.yaml     @Ubuntu-25c-market-prep/argocd
/infrastructures/dev/25c-shared/000-cluster-wide-resources/namespace/app-stage.yaml   @Ubuntu-25c-market-prep/argocd
/infrastructures/dev/25c-shared/000-cluster-wide-resources/namespace/app-prod.yaml    @Ubuntu-25c-market-prep/argocd
/infrastructures/dev/25c-shared/000-cluster-wide-resources/namespace/argocd.yaml      @Ubuntu-25c-market-prep/argocd
